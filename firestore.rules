rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'esterclara28@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins marker collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBootstrappedAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Activity Logs (Audit Trail)
    match /activity_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Community Records (Posyandu / UKS / Assisted Citizens)
    match /community_records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.kaderId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.kaderId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
